# ── Database (default matches docker-compose.yml) ──────────────────────────
DATABASE_URL="postgresql://civic:civic@localhost:5432/civic_tracker"

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""   # openssl rand -base64 32

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Map ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── Local AI (Ollama + LLaVA) ────────────────────────────────────────────────
# Install: https://ollama.com/download
# Setup:   ollama pull llava && ollama serve
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llava"

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────
# Generate keys once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""   # same value as VAPID_PUBLIC_KEY

# ── Cron (Vercel only) ────────────────────────────────────────────────────────
CRON_SECRET=""   # openssl rand -base64 32

# ── Demo logins (local development only) ─────────────────────────────────────
# Lets anyone sign in as demo, admin or NGO with a fixed password. Never enable in production.
ENABLE_DEMO_LOGIN="false"
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
